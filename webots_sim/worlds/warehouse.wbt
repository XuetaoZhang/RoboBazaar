# ========== E-PUCK ROBOTS (simple, stable) ==========
DEF ROBOT_01 E-puck {
  translation -2 0 0
  name "robot_01"
  controller "epuck_controller"
  emitter_channel 1
  receiver_channel 2
}

DEF ROBOT_02 E-puck {
  translation 0 0 0
  name "robot_02"
  controller "epuck_controller"
  emitter_channel 1
  receiver_channel 2
}

DEF ROBOT_03 E-puck {
  translation 2 0 0
  name "robot_03"
  controller "epuck_controller"
  emitter_channel 1
  receiver_channel 2
}

# ========== HUMAN OPERATOR ==========
DEF HUMAN Pedestrian {
  translation 0 0 1.5
  name "human"
  controller "human_controller"
  shirtColor 0.2 0.4 0.8
  pantsColor 0.1 0.1 0.2
}

# ========== SUPERVISOR ==========
DEF SUPERVISOR Robot {
  children [
    Emitter { name "emitter" channel 2 }
    Receiver { name "receiver" channel 1 }
  ]
  name "supervisor"
  controller "supervisor"
  supervisor TRUE
}
